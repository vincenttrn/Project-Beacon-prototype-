# Site URL (set to your Vercel URL for test, e.g. https://your-project.vercel.app)
VITE_SITE_URL=

# EmailJS — team notification on new enquiry
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
ENQUIRY_NOTIFY_EMAIL=vincenttrn02@gmail.com

# Resend — reply emails from Discord
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL=onboarding@resend.dev

# Discord — enquiry alerts + in-Discord reply
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_PUBLIC_KEY=

# Upstash Redis (required — link via Vercel Storage → Upstash Redis/KV)
KV_REST_API_URL=
KV_REST_API_TOKEN=
